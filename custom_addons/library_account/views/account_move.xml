<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_view_form_inherit_library" model="ir.ui.view">
        <field name="name">account.move.form.inherit.library</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_loans" type="object" class="oe_stat_button" icon="fa-book" invisible="not loan_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Library Loan</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
