<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="library_loan_view_list_inherit_account" model="ir.ui.view">
        <field name="name">library.loan.view.list.inherit.account</field>
        <field name="model">library.loan</field>
        <field name="inherit_id" ref="library_management.library_loan_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="/list" position="attributes">
                <attribute name="decoration-success">
                    (state == 'returned' and invoice_payment_state == 'paid') or (state == 'returned' and total_late_fee == 0)
                </attribute>
            </xpath>
            <xpath expr="/list/field[@name='total_late_fee']" position="after">
                <field name="invoice_payment_state" column_invisible="True"/>
            </xpath>
        </field>
    </record>


    <record id="library_loan_view_form_inherit_account" model="ir.ui.view">
        <field name="name">library.loan.form.inherit.account</field>
        <field name="model">library.loan</field>
        <field name="inherit_id" ref="library_management.library_loan_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-money" invisible="invoice_id == False">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Bill</span>
                            <span class="o_stat_value">View Detail</span>
                        </div>
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
