<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_loans_template" name="My Loans">
        <t t-call="website.layout">
            <div id="wrap" class="container my-5">

                <h3 class="mb-4 fw-bold text-primary">Dashboard Peminjaman Buku</h3>

                <div class="row g-4">
                    <t t-if="not loans">
                        <div class="col-12 alert alert-info text-center py-4 rounded-3 shadow-sm mb-0">
                            <i class="fa fa-info-circle fa-2x me-2 align-middle"/>
                            <span>Kamu belum meminjam buku apa pun saat ini.</span>
                        </div>
                    </t>

                    <t t-else="">
                        <div t-foreach="loans" t-as="loan" class="col-md-6 col-lg-4">
                            <div class="card shadow-sm h-100 border-0 rounded-3">

                                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
                                    <strong class="text-truncate" t-att-title="loan.name">
                                        <t t-out="loan.name"/>
                                    </strong>

                                    <span t-attf-class="badge #{'text-bg-success' if loan.state == 'returned' else 'text-bg-danger' if loan.state == 'late' else 'text-bg-warning text-dark'}"
                                          t-field="loan.state"/>
                                </div>

                                <div class="card-body d-flex flex-column justify-content-between">
                                    <div class="card-text">
                                        <div class="mb-2 d-flex align-items-center">
                                            <i class="fa fa-calendar me-2 text-muted"/>
                                            <strong class="me-1">Tenggat:</strong>
                                            <span t-field="loan.date_return_expected" t-options="{'widget': 'date'}"/>
                                        </div>

                                        <div class="d-flex align-items-center">
                                            <t t-if="loan.total_late_fee &gt; 0">
                                                <i class="fa fa-money-bill me-2 text-danger"/>
                                                <strong class="text-danger">
                                                    Denda: <span t-field="loan.total_late_fee" t-options="{'widget': 'monetary', 'display_currency': loan.currency_id if 'currency_id' in loan else None}"/>
                                                </strong>
                                            </t>

                                            <t t-else="">
                                                <i class="fa fa-check-circle me-2 text-success"/>
                                                <span class="text-success fw-medium">
                                                    Tidak ada denda
                                                </span>
                                            </t>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </t>
                </div>

            </div>
        </t>
    </template>
</odoo>