<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tambahkan Smart Button Surat Jalan di Form Peminjaman -->
    <record id="view_library_loan_form_inherit_stock" model="ir.ui.view">
        <field name="name">library.loan.form.inherit.stock</field>
        <field name="model">library.loan</field>
        <field name="inherit_id" ref="library_management.library_loan_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_pickings" type="object" class="oe_stat_button" icon="fa-truck" invisible="picking_count == 0">
                    <field name="picking_count" widget="statinfo" string="Surat Jalan"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>