<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_view_form_inherit_library" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.library</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_loan" type="object" class="oe_stat_button" icon="fa-book" invisible="not loan_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Peminjaman</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>