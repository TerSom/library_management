<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- LIST VIEW -->
        <record id="library_loan_view_list" model="ir.ui.view">
            <field name="name">library.loan.view.list</field>
            <field name="model">library.loan</field>
            <field name="arch" type="xml">
                <list string="Loans" decoration-danger="total_late_fee > 0 and state != 'returned'" decoration-success="state == 'returned'">
                    <field name="name" />
                    <field name="member_id" />
                    <field name="date_borrow" />
                    <field name="date_return_expected" />
                    <field name="state" widget="badge"/>
                    <field name="total_late_fee" />
                </list>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="library_loan_view_form" model="ir.ui.view">
            <field name="name">library.loan.view.form</field>
            <field name="model">library.loan</field>
            <field name="arch" type="xml">
                <form string="">
                    <header>
                        <button string="Confirm" name="action_confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                        <button string="Return" name="action_return" type="object" class="oe_highlight" invisible="state != 'ongoing'"/>
                        <button string="Email" name="action_send_email" type="object" class="btn-secondary" invisible="state != 'ongoing'" />
                        <field name="state" widget="statusbar" statusbar_visible="draft,ongoing,returned" />
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" />
                            </h1>
                        </div>
                        <group>
                            <group string="Informasi Utama">
                                <field name="member_id"/>
                                <field name="total_late_fee" />
                            </group>
                            <group string="Tanggal">
                                <field name="date_borrow"/>
                                <field name="date_return_expected"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Loan Lines">
                                <field name="loan_line_ids">
                                    <list editable="bottom">
                                        <field name="book_id"/>
                                        <field name="date_return_actual" />
                                        <field name="late_fee" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
    </data>
</odoo>