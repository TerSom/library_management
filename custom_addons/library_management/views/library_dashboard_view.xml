<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dashboard Client Action (OWL Component) -->
    <record id="action_library_dashboard_client" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">library_dashboard</field>
    </record>

    <!-- Keep kanban view as fallback -->
    <record id="library_dashboard_kanban_view" model="ir.ui.view">
        <field name="name">library.dashboard.kanban</field>
        <field name="model">library.dashboard</field>
        <field name="arch" type="xml">
            <kanban class="o_library_dashboard" create="false" edit="false" delete="false">
                <field name="name"/>
                <field name="total_books"/>
                <field name="total_members"/>
                <field name="active_loans_count"/>
                <field name="overdue_loans_count"/>
                <field name="monthly_loans_count"/>
                <field name="total_late_fee"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="container-fluid p-3">
                            <div class="row g-3">
                                <div class="col-md-3 col-6">
                                    <div class="card border-0 shadow-sm text-center p-3">
                                        <i class="fa fa-book fa-2x text-primary mb-2"/>
                                        <h3 class="fw-bold text-primary mb-0"><field name="total_books"/></h3>
                                        <small class="text-muted">Total Buku</small>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6">
                                    <div class="card border-0 shadow-sm text-center p-3">
                                        <i class="fa fa-users fa-2x text-info mb-2"/>
                                        <h3 class="fw-bold text-info mb-0"><field name="total_members"/></h3>
                                        <small class="text-muted">Total Anggota</small>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6">
                                    <div class="card border-0 shadow-sm text-center p-3">
                                        <i class="fa fa-exchange fa-2x text-success mb-2"/>
                                        <h3 class="fw-bold text-success mb-0"><field name="active_loans_count"/></h3>
                                        <small class="text-muted">Pinjaman Aktif</small>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6">
                                    <div class="card border-0 shadow-sm text-center p-3">
                                        <i class="fa fa-exclamation-triangle fa-2x text-danger mb-2"/>
                                        <h3 class="fw-bold text-danger mb-0"><field name="overdue_loans_count"/></h3>
                                        <small class="text-muted">Terlambat</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Loan Analysis Action -->
    <record id="action_loan_analysis" model="ir.actions.act_window">
        <field name="name">Analisis Pinjaman</field>
        <field name="res_model">library.loan</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">{'group_by': ['date_borrow']}</field>
    </record>

    <!-- Popular Books Analysis -->
    <record id="action_popular_books_analysis" model="ir.actions.act_window">
        <field name="name">Buku Populer</field>
        <field name="res_model">library.loan.line</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">{'group_by': ['book_id']}</field>
    </record>
</odoo>
