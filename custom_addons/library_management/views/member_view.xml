<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="library_member_view_list" model="ir.ui.view">
        <field name="name">library.member.view.list</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <list >
                <field name="name" />
                <field name="member_number" />
                <field name="phone" />
                <field name="registration_date" />
            </list>
        </field>
    </record>

    <record id="library_memeber_view_form" model="ir.ui.view">
        <field name="name">library.member.view.form</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <div class="oe_title">
                        <label for="partner_id" class="oe_edit_only"/>
                        <h1>
                            <field name="partner_id" placeholder="e.g. Harry Potter"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="member_number" />
                            <field name="phone" />
                            <field name="mobile" />
                            <field name="email" />
                        </group>
                        <group>
                            <field name="website" />
                            <field name="function" />
                            <field name="title" />
                            <field name="registration_date" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
