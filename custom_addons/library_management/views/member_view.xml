<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="library_member_view_list" model="ir.ui.view">
        <field name="name">library.member.view.list</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <list string="Members" sample="1">
                <field name="partner_id" widget="many2one_avatar"/>
                <field name="name" decoration-bf="1"/>
                <field name="member_number" decoration-bf="1"/>
                <field name="member_type" widget="badge"/>
                <field name="max_loan_limit"/>
                <field name="phone" widget="phone"/>
                <field name="email" widget="email"/>
                <field name="registration_date"/>
            </list>
        </field>
    </record>

    <record id="library_memeber_view_form" model="ir.ui.view">
        <field name="name">library.member.view.form</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <form string="Library Member">
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'avatar_128', 'size': [90, 90]}"/>
                    <div class="oe_title">
                        <label for="partner_id" class="oe_edit_only" string="Nama Member"/>
                        <h1>
                            <field name="partner_id" placeholder="e.g. John Doe" options="{'no_quick_create': True}"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Keanggotaan">
                            <field name="member_number" placeholder="e.g. LIB-0001"/>
                            <field name="member_type"/>
                            <field name="max_loan_limit"/>
                            <field name="registration_date"/>
                        </group>
                        <group string="Kontak">
                            <field name="phone" widget="phone"/>
                            <field name="mobile" widget="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                    </group>
                    <group string="Informasi Tambahan">
                        <group>
                            <field name="website" widget="url"/>
                            <field name="function" placeholder="e.g. Mahasiswa"/>
                        </group>
                        <group>
                            <field name="title" options="{'no_create': True}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
