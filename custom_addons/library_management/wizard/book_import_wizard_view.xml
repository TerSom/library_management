<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- 1. Form View untuk Pop-up -->
    <record id="view_book_import_wizard_form" model="ir.ui.view">
        <field name="name">book.import.wizard.form</field>
        <field name="model">book.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Books from Google API">
                <group>
                    <!-- Input untuk kata kunci pencarian -->
                    <field name="keyword" placeholder="Contoh: React Framework..."/>
                </group>
                <footer>
                    <!-- Tombol eksekusi pemanggil action_import_books -->
                    <button string="Tarik Data API" type="object" name="action_import_books" class="btn-primary"/>
                    <button string="Batal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- 2. Action untuk membuka form Wizard -->
    <record id="action_book_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Books API</field>
        <field name="res_model">book.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


</odoo>