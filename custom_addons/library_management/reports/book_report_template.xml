<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_book_detail_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <div class="text-center mb-4">
                                <h2>Laporan Detail Buku</h2>
                            </div>

                            <div class="row mt-4">
                                <div class="col-4 text-center">
                                    <t t-if="doc.cover_image">
                                        <img t-att-src="image_data_uri(doc.cover_image)" style="max-height: 250px; max-width: 100%; border: 1px solid #ddd; padding: 5px;"/>
                                    </t>
                                    <t t-else="">
                                        <div style="height: 250px; background-color: #f8f9fa; border: 1px solid #ddd; display: flex; align-items: center; justify-content: center;">
                                            <span class="text-muted">Tidak Ada Cover</span>
                                        </div>
                                    </t>
                                </div>
                                <div class="col-8">
                                    <table class="table table-sm table-borderless">
                                        <tbody>
                                            <tr>
                                                <td style="width: 30%;"><strong>Judul Buku</strong></td>
                                                <td style="width: 5%;">:</td>
                                                <td><span t-field="doc.name"/></td>
                                            </tr>
                                            <tr>
                                                <td><strong>ISBN</strong></td>
                                                <td>:</td>
                                                <td><span t-field="doc.isbn"/></td>
                                            </tr>
                                            <tr>
                                                <td><strong>Penulis</strong></td>
                                                <td>:</td>
                                                <td><span t-field="doc.author_id.name"/></td>
                                            </tr>
                                            <tr>
                                                <td><strong>Penerbit</strong></td>
                                                <td>:</td>
                                                <td><span t-field="doc.publisher_id.name"/></td>
                                            </tr>
                                            <tr>
                                                <td><strong>Jumlah Halaman</strong></td>
                                                <td>:</td>
                                                <td><span t-field="doc.pages"/></td>
                                            </tr>
                                            <tr>
                                                <td><strong>Status</strong></td>
                                                <td>:</td>
                                                <td>
                                                    <span t-if="doc.active" class="badge bg-success">Aktif</span>
                                                    <span t-else="" class="badge bg-danger">Non-Aktif</span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
