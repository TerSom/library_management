<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <template id="report_loan_reception_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <div class="text-center mb-4">
                                <h2>Struk Peminjaman Buku</h2>
                                <h4>
                                    <strong>No. Ref: </strong>
                                    <span t-field="doc.name"/>
                                </h4>
                            </div>

                            <!-- Informasi (Format 2 Kolom dengan Bootstrap) -->
                            <div class="row mt-4 mb-4">
                                <div class="col-6">
                                    <strong>Informasi Anggota:</strong>
                                    <br/>
                                    Nama: <span t-field="doc.member_id.partner_id.name"/>
                                <br/>
                                    ID Anggota: <span t-field="doc.member_id.member_number"/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Informasi Peminjaman:</strong>
                                <br/>
                                    Tgl Pinjam: <span t-field="doc.date_borrow"/>
                            <br/>
                                    Tenggat Waktu: <span t-field="doc.date_return_expected"/>
                        </div>
                    </div>

                    <!-- Tabel Detail Buku -->
                    <table class="table table-sm o_main_table mt-4">
                        <thead style="background-color: #f8f9fa;">
                            <tr>
                                <th>Judul Buku</th>
                                <th>ISBN</th>
                                <th>Penulis</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="items" t-value="doc.loan_line_ids"/>
                            <tr t-foreach="items" t-as="item">
                                <td>
                                    <span t-field="item.book_id.name"/>
                                </td>
                                <td>
                                    <span t-field="item.book_id.isbn"/>
                                </td>
                                <td>
                                    <span t-field="item.book_id.author_id.name"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Bagian Bawah / Footer Konten -->
                    <div class="mt-5">
                        <p>
                            <strong>Status Saat Ini: </strong>
                            <span t-field="doc.state"/>
                        </p>

                        <!-- t-if: Hanya muncul jika kondisinya terpenuhi (ada denda) -->
                        <p t-if="doc.total_late_fee > 0" class="text-danger">
                            <strong>Total Denda: </strong> 
                                    Rp. <span t-field="doc.total_late_fee"/>
                        </p>
                    </div>
                </div>
            </t>
        </t>
    </t>
</template>
</data>
</odoo>